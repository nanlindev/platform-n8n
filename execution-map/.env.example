# n8n Public API (server-side proxy only — do not prefix with VITE_)
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=

# Deep link into official editor (safe for client)
VITE_N8N_EDITOR_BASE_URL=http://127.0.0.1:5678

# Optional: hide execution ids from the list UI (comma-separated). Does not delete in n8n.
# VITE_HIDE_EXECUTION_IDS=1149
